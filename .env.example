# Copy this file to .env.local. Use the values shown by `npm run supabase:start`
# for local development, or the Connect dialog for a hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SECRET_KEY=replace-with-your-server-only-secret-key
# Optional dedicated HMAC secret for public-booking abuse controls. Use a long,
# random server-only value. If omitted, SUPABASE_SECRET_KEY is used.
PUBLIC_BOOKING_RATE_LIMIT_SECRET=replace-with-a-long-random-server-only-value

# Never add either server secret or a service-role key to NEXT_PUBLIC_* variables.
